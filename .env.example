# Copia este archivo a .env y ajusta el valor.
#
# IMPORTANTE: Vite inyecta las variables VITE_* en tiempo de COMPILACIÓN,
# no en tiempo de ejecución. Es decir, el valor queda escrito dentro de los
# archivos JavaScript generados por "npm run build". Por eso, al desplegar en
# AWS hay que recompilar el frontend apuntando a la URL real del backend.
#
# Corolario de seguridad: NUNCA pongas secretos en variables VITE_*,
# porque quedan visibles para cualquiera que abra el navegador.

# Local (Docker Compose)
VITE_API_URL=http://localhost:8000

# Producción (ejemplo, se reemplaza por la URL real de App Runner)
# VITE_API_URL=https://xxxxxxxx.us-east-1.awsapprunner.com

# Servicio de clasificación de imágenes
VITE_ML_API_URL=http://localhost:8100/ml
